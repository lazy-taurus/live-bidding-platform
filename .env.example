# Docker Compose Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - only .env.example should be in the repo

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local development uses Docker service name
# Production: mongodb+srv://user:pass@cluster.mongodb.net/live-bidding?retryWrites=true&w=majority
MONGO_URI=mongodb://mongodb:27017/live-bidding

# JWT Secret - Change this to a strong random string in production
JWT_SECRET=change_me_in_production_use_strong_random_string

# Frontend URL for backend CORS
CLIENT_URL=http://localhost:3000

# Frontend API URL
VITE_API_URL=http://localhost:5000
